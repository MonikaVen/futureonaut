ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345
# Optional local demo logins. Leave blank in production so they are not seeded.
TEACHER_EMAIL=teacher@example.com
TEACHER_PASSWORD=teacher12345
CREATOR_EMAIL=futureonaut@example.com
CREATOR_PASSWORD=creator12345
CREATOR_DISPLAY_NAME=futureonaut
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
CORS_ORIGINS=http://localhost:5173,http://localhost:3080,http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3080
# Required in production so share pages ignore spoofed Host / X-Forwarded-Host headers.
JWT_SECRET=change-me-in-production-learnplay-secret
